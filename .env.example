SECRET_KEY=cambia-esta-clave-por-una-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

SITE_NAME=Diego Elorza | Control Automático
SITE_OWNER_NAME=Diego Elorza
# Dominio de producción (sin https://), usado en sitemap/robots/redes sociales si no hay request disponible.
SITE_DOMAIN=controlautomatico-app.azurewebsites.net
# Correo de contacto mostrado en el footer y en las páginas legales.
CONTACT_EMAIL=diego@urbanatika.org

# Identidad legal usada en Términos y Condiciones / Política de Privacidad.
LEGAL_ENTITY_NAME=Urbanatika
LEGAL_ENTITY_RUT=65.177.213-3

# Formulario de contacto: destinatario de los mensajes y remitente de los correos del sitio.
CONTACT_FORM_RECIPIENT=contacto@urbanatika.org
DEFAULT_FROM_EMAIL=Diego Elorza <diego@urbanatika.org>

# Redes sociales mostradas en el footer. Deja en blanco para ocultar un ícono.
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/diegoelorza/
SOCIAL_LINKEDIN_URL=https://www.linkedin.com/in/diegoelorza/
SOCIAL_YOUTUBE_URL=https://www.youtube.com/@urbanatika
SOCIAL_X_URL=https://x.com/elorza_diego

# Mercado Pago (Developers > Tus integraciones > Credenciales)
# Usa primero las credenciales de PRUEBA (test) antes de pasar a producción.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxx
# Secreto de firma de webhooks (Developers > Tus integraciones > Webhooks > Firma secreta)
MERCADOPAGO_WEBHOOK_SECRET=

# Precios en pesos chilenos (CLP). Los valores por defecto son un equivalente
# aproximado a US$15/mes y US$120/año — ajústalos al tipo de cambio actual.
MERCADOPAGO_MONTHLY_AMOUNT_CLP=14990
MERCADOPAGO_ANNUAL_AMOUNT_CLP=119990

# Solo producción
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Azure Blob Storage para media/ (miniaturas, comprobantes) — solo producción.
# Si se dejan vacíos, se usa almacenamiento local (no persiste entre deploys).
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media
